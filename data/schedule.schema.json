{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/OWNER/rt521-schedule/main/data/schedule.schema.json",
  "title": "RT-521 schedule data",
  "type": "object",
  "required": ["group", "semester", "academic_year", "semester_start", "schedule"],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "group": { "type": "string", "minLength": 1 },
    "semester": { "type": "integer", "minimum": 1 },
    "academic_year": { "type": "string", "pattern": "^\\d{4}/\\d{4}$" },
    "semester_start": { "type": "string", "format": "date" },
    "updated_at": { "type": "string", "format": "date-time" },
    "schedule": { "$ref": "#/$defs/schedule" },
    "changes": {
      "type": "array",
      "items": { "$ref": "#/$defs/change" }
    },
    "works": {
      "type": "array",
      "items": { "$ref": "#/$defs/work" }
    }
  },
  "$defs": {
    "weeks": {
      "oneOf": [
        { "const": "all" },
        {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 1, "maximum": 52 }
        }
      ]
    },
    "time": {
      "type": "string",
      "pattern": "^\\d{1,2}:\\d{2}-\\d{1,2}:\\d{2}$",
      "examples": ["14:10-15:50"]
    },
    "teachers": {
      "type": "array",
      "items": { "type": "string" }
    },
    "lesson": {
      "type": "object",
      "required": ["time", "subject"],
      "properties": {
        "time": { "$ref": "#/$defs/time" },
        "subject": { "type": "string", "minLength": 1 },
        "room": { "type": "string" },
        "teachers": { "$ref": "#/$defs/teachers" },
        "weeks": { "$ref": "#/$defs/weeks" }
      }
    },
    "lessons": {
      "type": "array",
      "items": { "$ref": "#/$defs/lesson" }
    },
    "schedule": {
      "type": "object",
      "required": ["monday", "tuesday", "wednesday", "thursday", "friday", "saturday", "sunday"],
      "properties": {
        "monday": { "$ref": "#/$defs/lessons" },
        "tuesday": { "$ref": "#/$defs/lessons" },
        "wednesday": { "$ref": "#/$defs/lessons" },
        "thursday": { "$ref": "#/$defs/lessons" },
        "friday": { "$ref": "#/$defs/lessons" },
        "saturday": { "$ref": "#/$defs/lessons" },
        "sunday": { "$ref": "#/$defs/lessons" }
      },
      "additionalProperties": false
    },
    "change": {
      "type": "object",
      "required": ["date", "kind", "time"],
      "properties": {
        "date": { "type": "string", "format": "date" },
        "kind": {
          "type": "string",
          "enum": ["replace", "extra", "cancel", "note"]
        },
        "time": { "$ref": "#/$defs/time" },
        "subject": { "type": "string" },
        "room": { "type": "string" },
        "teachers": { "$ref": "#/$defs/teachers" },
        "note": { "type": "string" }
      }
    },
    "work": {
      "type": "object",
      "required": ["date", "subject"],
      "properties": {
        "date": { "type": "string", "format": "date" },
        "subject": { "type": "string", "minLength": 1 },
        "type": { "type": "string" },
        "title": { "type": "string" },
        "note": { "type": "string" }
      }
    }
  }
}
