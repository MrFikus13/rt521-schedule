<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_date"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Сегодня · ЧТ, 26 НОЯ"
            android:textColor="@color/widget_secondary"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/widget_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="СЕЙЧАС"
            android:textColor="@color/widget_accent"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_subject"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="Цифровые микропроцессорные устройства"
        android:textColor="@color/widget_text"
        android:textSize="18sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_meta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="09:55–11:35 · каб. 155"
            android:textColor="@color/widget_secondary"
            android:textSize="11sp" />

        <Chronometer
            android:id="@+id/widget_timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/widget_accent"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="4dp"
        android:background="@color/widget_divider" />

    <LinearLayout
        android:id="@+id/widget_row1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="3dp"
        android:paddingBottom="3dp">

        <TextView
            android:id="@+id/widget_row1_time"
            android:layout_width="52dp"
            android:layout_height="wrap_content"
            android:text="09:55"
            android:textColor="@color/widget_secondary"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/widget_row1_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Цифровые микропроцессорные устройства"
            android:textColor="@color/widget_text"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/widget_row1_room"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="каб. 155"
            android:textColor="@color/widget_secondary"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_row2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="3dp"
        android:paddingBottom="3dp">

        <TextView
            android:id="@+id/widget_row2_time"
            android:layout_width="52dp"
            android:layout_height="wrap_content"
            android:text="12:15"
            android:textColor="@color/widget_secondary"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/widget_row2_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Основы построения систем и сетей…"
            android:textColor="@color/widget_text"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/widget_row2_room"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="каб. 123"
            android:textColor="@color/widget_secondary"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_row3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="3dp"
        android:paddingBottom="3dp">

        <TextView
            android:id="@+id/widget_row3_time"
            android:layout_width="52dp"
            android:layout_height="wrap_content"
            android:text="14:10"
            android:textColor="@color/widget_secondary"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/widget_row3_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Метрология и специальные измерения"
            android:textColor="@color/widget_text"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/widget_row3_room"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="каб. 109"
            android:textColor="@color/widget_secondary"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_row4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="3dp"
        android:paddingBottom="3dp">

        <TextView
            android:id="@+id/widget_row4_time"
            android:layout_width="52dp"
            android:layout_height="wrap_content"
            android:text="16:20"
            android:textColor="@color/widget_secondary"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/widget_row4_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Направляющие системы телекоммуникаций"
            android:textColor="@color/widget_text"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/widget_row4_room"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="каб. 205"
            android:textColor="@color/widget_secondary"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_row5"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="3dp"
        android:paddingBottom="3dp">

        <TextView
            android:id="@+id/widget_row5_time"
            android:layout_width="52dp"
            android:layout_height="wrap_content"
            android:textColor="@color/widget_secondary"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/widget_row5_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_text"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/widget_row5_room"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/widget_secondary"
            android:textSize="10sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_work"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/widget_accent"
        android:textSize="10sp"
        android:visibility="gone" />
</LinearLayout>
